                "QTableWidget::item:selected": "background: #1a1d20;",
                "QHeaderView::section": "background: #0a0c0d; color: #7a6346; padding: 6px; border: 1px solid #1f2225; font-family: 'Cinzel', serif;",
                "QScrollBar:vertical": "background: #111416; width: 8px;",
